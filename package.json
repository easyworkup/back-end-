    "@nestjs/config": "^3.3.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/bullmq": "^10.2.0",
    "bullmq": "^5.13.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "@prisma/client": "^5.20.0",
    "nestjs-zod": "^4.2.0",
    "zod": "^3.23.0",
    "ioredis": "^5.4.1",
